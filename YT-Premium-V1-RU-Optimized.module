# Updated: 2026-10-25
# Based on YT-Premium-V1-RU by misha-tgshv; Shadowrocket module
#!name=YouTube Premium RU (Optimized)
#!desc=YouTube ad filtering, background playback, PiP and Russian caption options
#!arguments=blockUpload:true,blockImmersive:true,blockShorts:false,captionLang:off,lyricLang:off,scriptExecutionEngine:auto,debug:false

# Ads served over QUIC/UDP cannot be inspected by the HTTPS response script.
# Blocking UDP for these hosts makes YouTube fall back to TCP so the rules below can apply.
[Rule]
AND,((DOMAIN-SUFFIX,googlevideo.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN,youtubei.googleapis.com),(PROTOCOL,UDP)),REJECT

[Url Rewrite]
# Video ad requests
^https?:\\/\\/[\\w-]+\\.googlevideo\\.com\\/(?!(dclk_video_ads|videoplayback\\?)).+&oad _ reject-200
^https?:\\/\\/(www|s)\\.youtube\\.com\\/api\\/stats\\/ads _ reject-200
^https?:\\/\\/(www|s)\\.youtube\\.com\\/(pagead|ptracking) _ reject-200
^https?:\\/\\/s\\.youtube\\.com\\/api\\/stats\\/qoe\\?adcontext _ reject-200
# Remove the low-tier ad marker from eligible video requests
(^https?:\\/\\/[\\w-]+\\.googlevideo\\.com\\/(?!dclk_video_ads).+?)&ctier=L(&.+?),ctier,(.+) $1$2$3 302

[Map Local]
^https?:\\/\\/[\\w-]+\\.googlevideo\\.com\\/initplayback.+&oad data-type=text data="" status-code=200

[Script]
# Response-body processing is needed for feed ad removal, PiP and background playback.
# Keep the match limited to YouTube Innertube endpoints handled by the response script.
youtube.response = type=http-response,pattern=^https:\\/\\/youtubei\\.googleapis\\.com\\/youtubei\\/v1\\/(browse|next|player|search|reel\\/reel_watch_sequence|guide|account\\/get_setting|get_watch)(\\?(.*))?$,requires-body=1,max-size=-1,binary-body-mode=1,engine={{{scriptExecutionEngine}}},script-path=https://raw.githubusercontent.com/Maasea/sgmodule/master/Script/Youtube/youtube.response.js,argument="{\"lyricLang\":\"{{{lyricLang}}}\",\"captionLang\":\"{{{captionLang}}}\",\"blockUpload\":{{{blockUpload}}},\"blockImmersive\":{{{blockImmersive}}},\"blockShorts\":{{{blockShorts}}},\"debug\":{{{debug}}}}"

[MITM]
hostname = %APPEND% -redirector*.googlevideo.com,*.googlevideo.com,www.youtube.com,s.youtube.com,youtubei.googleapis.com
